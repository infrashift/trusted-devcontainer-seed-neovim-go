# A tmux + Neovim + Go workspace, and it is TWO THINGS IN ONE IMAGE ON PURPOSE.
#
# The first half is the InfraShift trusted neovim-go devcontainer: the same
# digest-pinned Fedora 43 base, the same package baseline, and thirteen of the
# fourteen features the published template names. The fourteenth, `sshd', is
# left out on purpose -- see section 2. One feature is ADDED: `cuelang', at the
# digest the trusted go-cue template (v1.0.3) pins, which depends on the same
# bootstrap as the rest -- CUE ships by default beside Go, as it does in the
# go-cue workspace. The Dev Container CLI installs the features from
# devcontainer.json; this file is the image they are installed onto.
#
# The second half is the WORKSPACE RUNTIME CONTRACT -- sshd, an entrypoint, a
# skeleton project directory -- which the devpod jobspec assumes and a plain
# devcontainer does not have. Putting it here rather than layering it on
# afterwards is the whole point of the arrangement: the forge's build output IS
# the image that runs, so the image that was built, scanned, signed and published is
# the image the developer connects to. There is no second build, and no gap
# between what was attested and what is running.
#
# THE ACCOUNT IS `user', NOT THE TEMPLATE'S `dev', AND THE UID/GID MATTER.
# uid 1001 gid 0 is the platform contract, assumed in four places that are not
# per-workspace: the onboarding portal renders `User user' from a single
# WORKSPACE_SSH_USER env var, container/config/sshd_config names it, the
# jobspec's volume-init chowns to it, and the portal's README tells the
# developer their work lives in /home/user/workspace. Renaming the account here
# is a one-line deviation from the template that leaves every one of those
# unchanged; making them per-workspace instead is strictly more work for the
# same result.
#
# THE REFERENCES ARE ghcr.io AND ARE LEFT THAT WAY. The Dev Container CLI
# fetches a feature from the registry its reference names, so whatever is
# written here is where the pull goes, and a committed repository must not carry a
# datacenter's address. sm-http-egress allows ghcr.io and
# pkg-containers.githubusercontent.com for exactly this. The nexus-oci
# ghcr proxy is the governed path for anything that addresses it explicitly.
FROM ghcr.io/infrashift/trusted-base-images/trusted/fedora43-minimal@sha256:382dde3e8556e4ee9c57c699187b8b2b1a3e338e33819c0f4937cc5386cf97de

USER root

# --- 1. The template's own package baseline -----------------------------------
#
# Feature prerequisites (tar, gzip, curl, util-linux) and the interactive
# baseline fedora43-minimal ships none of. The same packages as the template's
# Containerfile, and its `upgrade' first: `dnf5 install' of a package the base
# already carries is a no-op and never moves it to a newer build, so without
# the upgrade the base image's curl and openssl-libs stay at whatever Fedora
# had when it was built, which is what the CVE gate measures against.
#
# TWO RUN STEPS WHERE THE TEMPLATE HAS ONE, and that is the one change to it.
# The forge's pipeline reaches Fedora only through the platform's egress
# allow-list, so it mounts PINNED repo files over /etc/yum.repos.d for every
# RUN step (ci/devcontainer.gitlab-ci.yml, "A RUNNER REACHES THE INTERNET ONLY
# THROUGH SQUID"); writes there land in a per-step copy. The upgrade replaces
# fedora-repos, which writes Fedora's stock repo files -- metalinks on
# mirrors.fedoraproject.org -- into that copy, and an `install' later in the
# SAME step reads them and is refused with CONNECT 403 (bill/neovim-go
# pipeline 25, gcloud-dc 2026-09-25). A new step gets a fresh copy of the
# pinned files. Off the platform the split changes nothing.
RUN dnf5 -y upgrade --setopt=install_weak_deps=False \
    && dnf5 clean all && rm -rf /var/cache/dnf
RUN dnf5 -y install --allowerasing --setopt=install_weak_deps=False \
        tar gzip curl util-linux unzip libicu openssl-libs \
        procps-ng diffutils findutils less which fzf \
    && dnf5 clean all && rm -rf /var/cache/dnf

# --- 2. The workspace runtime -------------------------------------------------
#
# openssh-server is what the devpod jobspec's health check probes and what the
# developer's ssh -- or VS Code Remote-SSH -- connects to. It is NOT in the
# trusted base, and its absence would present as a workspace that starts,
# reports healthy on its container, and refuses every connection.
#
# THE TEMPLATE'S `sshd' FEATURE IS NOT DECLARED, and that is the one deviation
# from its feature list. It exists to make the template reachable on its own,
# started as a feature entrypoint by `devcontainer up': a rootless sshd for
# `dev', keys from /run/secrets, config in /etc/ssh/sshd_config.d. None of that
# is how a workspace runs. The devpod jobspec forces
# /usr/local/bin/entrypoint.sh (below) as root, renders the key at
# /secrets/authorized_keys, and every consumer logs in as `user' through the
# ForceCommand in config/sshd_config -- which REPLACES /etc/ssh/sshd_config, so
# the feature's drop-in would never even be read. Declaring it would put two SSH
# setups in one image, only one of them live.
#
# THE tmux LAYOUT NEEDS NO ForceCommand OF ITS OWN. The tmux feature's hook in
# /etc/profile.d/dev-session.sh starts the editor | shell layout on an
# interactive TTY login, and the contract's ssh-login.sh ends in `exec bash -l'
# for exactly that case -- so a terminal login lands in the layout and
# `ssh host cmd', VS Code's server and the verify probes get a plain shell.
# The layout sees the whole login environment even though dev-session.sh sorts
# before local-bin.sh and proxy.sh: sshd runs the ForceCommand through
# `bash -c', and bash sources ~/.bashrc when sshd starts it -- which sources
# /etc/bashrc and with it all of /etc/profile.d -- so PATH, the proxies and the
# registry are already exported by the time `bash -l' reaches the hook.
#
# openssh-clients is the SSH CLIENT: what `git push' to the forge runs, over
# the agent forwarded from the developer's laptop. Not a dependency of
# openssh-server on Fedora, and its absence presents as git saying
# "ssh: command not found" inside a workspace that sshd serves perfectly well.
#
# THERE IS NO DATABASE CLIENT. This seed declares no companion service and sets
# builtin_database:false in .devcontainer/services.json, so there is no
# database beside the workspace to reach.
RUN dnf5 -y install --setopt=install_weak_deps=False \
        openssh-server openssh-clients rsync git \
    && dnf5 clean all && rm -rf /var/cache/dnf \
    && ssh-keygen -A

# THE DEFAULT BRANCH IS `main', stated in the image rather than left to git.
# The platform names every default branch main -- onboard-developer.sh PUTs
# `default_branch: main' on the project it creates, and the central pipeline
# publishes from main alone -- but git's own built-in default is still
# `master' and this image sets no system git config. So `git init' inside a
# workspace produced a branch the forge does not expect, and the developer
# found out at the first push (gcloud-dc 2026-09-20, chad/dotnet).
#
# --system, so a developer's own ~/.gitconfig still wins, and the git-lfs
# feature appends its filters to the same file when the CLI installs it.
RUN git config --system init.defaultBranch main

# --- 3. The account the platform expects --------------------------------------
#
# gid 0, not a private group: the host volume is chowned to uid 1001 gid 0 by
# the jobspec's volume-init task, and a home directory the developer cannot
# write presents as a broken image rather than a permissions problem. This is
# the deviation from the template's `dev' (1001:1001) and it is deliberate.
RUN id -u user >/dev/null 2>&1 || useradd -u 1001 -g 0 -m -s /bin/bash user
# A GROUP NAMED `user' EXISTS TOO, and it is not the primary group. The trusted
# features' shared runner drops to the target user for its userland lane with
# `setpriv --reuid=$_REMOTE_USER --regid=$_REMOTE_USER' -- the GROUP is looked
# up by the USER's name, which every template satisfies because they create
# both with one name. This image deliberately does not (gid 0, above), and the
# first userland feature, grype, died with `setpriv: failed to parse regid:
# 'user''. The group exists so the name resolves; files a userland feature
# installs land 1001:1001 under /home/user, which the developer owns by uid
# either way, and --init-groups still grants gid 0 from the passwd entry.
RUN getent group user >/dev/null 2>&1 || groupadd -g 1001 user

COPY config/sshd_config /etc/ssh/sshd_config

# The skeleton the volume-init prestart task copies into an EMPTY volume. It is
# staged outside /home/user because the volume is mounted over that path at
# runtime: anything written here under /home/user would be masked by the mount
# and look like it had silently failed to install.
COPY --chown=1001:0 workspace-skel/ /opt/workspace-skel/
COPY --chown=1001:0 entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh

# THE THIRD FILE OF THE CONTRACT, and the one the first two point at without
# saying so: config/sshd_config carries `ForceCommand
# /home/user/.local/bin/ssh-login.sh', so sshd refuses EVERY login -- interactive
# and VS Code's alike -- with `No such file or directory' if the wrapper is not
# at that path. Installed under /home/user because that is where sshd_config
# looks; the host volume mounts at /home/user/workspace, one level down, so this
# is not masked at runtime. `make test' asserts the two files agree.
COPY --chown=1001:0 config/ssh-login.sh /home/user/.local/bin/ssh-login.sh
RUN chmod 0755 /home/user/.local/bin/ssh-login.sh

# ~/.local/bin ON THE LOGIN PATH. Every feature in this image installs its tool
# under $_REMOTE_USER_HOME/.local/bin or links it there -- nvim, tree-sitter,
# stylua, shfmt, gopls, gofumpt, goimports, dlv, golangci-lint, jq, yq, syft,
# grype -- and the image's ENV PATH lists it. But sshd sanitises the
# environment, the ForceCommand starts `bash -l', and a Fedora login shell
# rebuilds PATH from /etc/profile, which does not add ~/.local/bin. So every
# feature would be invisible to an SSH session while present on disk.
RUN printf '%s\n' '# ~/.local/bin: where the trusted devcontainer features install' \
      'case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac' \
      'export PATH' > /etc/profile.d/local-bin.sh \
    && chmod 0644 /etc/profile.d/local-bin.sh

# THE TOOLCHAIN'S OWN DIRECTORIES, for the same reason as ~/.local/bin above.
# The golang feature installs under $_REMOTE_USER_HOME/.local/share/go and
# declares GOPATH and PATH in its containerEnv -- with `/home/dev' written into
# the values, the template's account, which this image does not have (see step
# 3). A feature's containerEnv is metadata for the container the CLI would
# start, not for an SSH session, so even a correct value would not survive
# sshd's login. Rebased on $HOME and rendered for the login shell instead: a
# plain `go' at the prompt, and `go install' output on the PATH.
#
# EDITOR and VISUAL too, which devcontainer.json's containerEnv states for the
# same container-not-session reason: `git commit' in an SSH login should open
# Neovim, not vi.
RUN printf '%s\n' '# The neovim-go toolchain: where the trusted features install it' \
      'export GOROOT="$HOME/.local/share/go"' \
      'export GOPATH="$HOME/.local/share/gopath"' \
      'for d in "$HOME/.local/share/go/bin" "$GOPATH/bin"; do' \
      '  case ":$PATH:" in *":$d:"*) ;; *) PATH="$d:$PATH" ;; esac' \
      'done' \
      'export PATH' \
      'export EDITOR=nvim VISUAL=nvim' > /etc/profile.d/neovim-go.sh \
    && chmod 0644 /etc/profile.d/neovim-go.sh

USER user
ENV HOME=/home/user
ENV PATH="/home/user/.local/bin:${PATH}"

# sshd is PID 1 rather than `sleep infinity'. A devcontainer's default command
# keeps a container alive for a tool that execs into it; this workspace is
# reached over the network and has nothing to exec through.
EXPOSE 2222
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
